# ==========================================
# OmniCare Financial - Environment Variables
# ==========================================
# Docker Compose reads this file. A variable marked Required below has no
# working default: compose fails to start with it missing.

# ── LLM Configuration ──────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) The model to use via LiteLLM
LLM_MODEL=openai/gpt-4o-mini

# (Optional) Point LiteLLM at a non-default OpenAI-compatible gateway
# OPENAI_API_BASE=

# ── Application Environment ────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Observability ──────────────────────────
# Master switch for the correlation-id middleware, structured JSON logs,
# per-tool latency instrumentation, and GET /api/v1/health/detailed. false
# removes the hooks themselves rather than only silencing their output.
OBSERVABILITY_ENABLED=true

# Registers the LiteLLM callback that records tokens, dollar cost, and latency
# per model call. Disable only when an external tracer already collects it.
LLM_COST_TRACKING_ENABLED=true

# "json" writes one JSON object per line with the request id as a field, which
# is what a log aggregator expects; "text" keeps the single-line human layout.
LOG_FORMAT=json

# ── Network & CORS ─────────────────────────
HOST=0.0.0.0
PORT=8000

# Comma-separated list or JSON array of allowed frontend URLs
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ── Frontend ───────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Authentication ─────────────────────────
# Set a strong random secret (e.g. 32+ bytes from /dev/urandom).
# This MUST be set in production; the code rejects the insecure default.
JWT_SECRET_KEY=your-secret-key-here

# ── Database ───────────────────────────────
# Required by docker-compose.yml: POSTGRES_PASSWORD is interpolated with
# ${POSTGRES_PASSWORD:?...}, so `docker compose up` aborts if it is unset.
# The db service creates the role and database named here on first boot; the
# same values appear in DATABASE_URL below.
POSTGRES_USER=omnicare
POSTGRES_PASSWORD=omnicare_password
POSTGRES_DB=omnicare

# Host port that the omnicare-db container publishes on. Keep it in sync with the
# port in DATABASE_URL. It is 15432 rather than 5432 so it does not collide with a locally
# installed PostgreSQL or another project's database container.
POSTGRES_HOST_PORT=15432
# PostgreSQL connection (requires asyncpg driver).
# The password must match POSTGRES_PASSWORD, and the user/database must match
# POSTGRES_USER/POSTGRES_DB.
DATABASE_URL=postgresql+asyncpg://omnicare:omnicare_password@localhost:15432/omnicare

# ── Test Database ────────────────────────────
# The suite deletes every row in every application table before each test, so it MUST
# NOT point at the database the running stack uses. The database name has to contain
# "test" or the run aborts.
OMNICARE_TEST_DATABASE_URL=postgresql+asyncpg://omnicare:omnicare_password@localhost:15432/omnicare_test

# ── Redis (shared state) ─────────────────────
# Redis makes two process-local behaviours correct when more than one replica serves
# traffic: an idempotent chat response replays from whichever instance the retry hits,
# and the 20/minute chat limit counts once for the deployment instead of once per
# replica. The value below is the address inside the compose network, so a container
# always finds it; comment it out to keep the original per-process behaviour, which is
# right for a single-process deployment, for tests, and for local development.
REDIS_URL=redis://redis:6379/0
# Host port the omnicare-redis container publishes on, on loopback only.
REDIS_HOST_PORT=16379

# How long to wait for a TCP connection / a reply before the store gives up and
# falls back to in-process state. Both are kept short so an unresponsive Redis
# never stalls a request.
# REDIS_CONNECT_TIMEOUT_SECONDS=1
# REDIS_SOCKET_TIMEOUT_SECONDS=2

# Where the idempotency cache lives: "memory" (default) or "redis". "redis" shares
# one cache across every replica; "redis" without a working REDIS_URL, and any Redis
# outage, fall back to "memory" rather than failing the request.
IDEMPOTENCY_STORAGE=memory

# Where rate-limit counters live: "memory" (default) or "redis". "redis" makes the
# per-minute limits global; an outage falls back to "memory", so a Redis problem
# cannot take the chat endpoints down with it.
RATE_LIMIT_STORAGE=memory

# ── Session Storage ──────────────────────────
# "memory" (default) keeps the ADK conversation sessions in the backend process, so
# any restart forgets the conversation in flight. "database" stores them in the
# agent_sessions and agent_session_events tables of the same PostgreSQL database, so
# any replica can continue any conversation and a restart no longer does. Redis is
# NOT involved: it carries idempotency and rate-limit state only. Switching a
# running deployment from "memory" to "database" abandons the sessions that process
# was holding: one time, acceptable, because the turns are already persisted.
SESSION_STORAGE=memory

# How many of the most recent persisted turns are replayed into a session that has
# none of its own (a restart, a new replica, or the first turn after the switch).
SESSION_HISTORY_TURNS=20

# How many older turns are folded into the summary that precedes the replayed
# history, so a long conversation still fits the model's context window.
SESSION_HISTORY_COMPACTION_TURNS=60

# ── Additional settings ──────────────────────
# Index the policy documents during API startup (default: true).
# INGEST_ON_STARTUP=true

# Index the procedure playbooks during API startup (default: true). Read directly
# from the environment by app/domain/procedures/ingestion.py, not by Settings.
# Ingestion is idempotent, so a warm boot costs a file read plus a snapshot compare.
# OMNICARE_INGEST_PROCEDURES=true

# Embedding drainer (the worker that turns embedding_jobs rows into pgvector entries).
# EMBEDDING_DRAIN_INTERVAL_SECONDS=5
# EMBEDDING_DRAIN_BATCH_SIZE=10

# Notification drainer (the worker that turns notification_jobs rows into entries in
# the recipient's in-app feed). Delivery never runs on the request path, so these only
# affect how quickly a claimant is told their claim moved.
# NOTIFICATION_DRAIN_INTERVAL_SECONDS=5
# NOTIFICATION_DRAIN_BATCH_SIZE=10

# Seconds after which a job stuck in "processing" is treated as abandoned by a dead
# worker and reclaimed to "pending". Guards both outbox drainers.
# JOB_STALE_AFTER_SECONDS=300

# Identity stamped onto jobs a drainer claims. Defaults to host-pid so concurrent
# drainers are distinguishable in locked_by; set it only to label a replica.
# WORKER_ID=omnicare-drain-1

# ── Embedding Model ─────────────────────────
# EMBEDDING_MODEL=text-embedding-3-small

# ── Data Files ─────────────────────────────
# POLICY_FILE_PATH=./app/data/sample_policy.md
