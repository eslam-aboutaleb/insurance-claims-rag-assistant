# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.local/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
backend/lib/
backend/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Python Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

