# ==============================================================================
# OmniCare Financial - Backend Environment Variables
# ==============================================================================
# The stack takes its values from the project-root .env through docker-compose.yml;
# this file documents the backend side of them, including the ones added with the
# shared session store and the Redis-backed caches.
#
# Note: Settings reads the project-root .env, not this file, so a container started
# with only ``backend/`` mounted needs DATABASE_URL passed in the environment.
# ``database_url`` is the one setting with no default and therefore the reason an
# import smoke test fails without it; the value docker-compose uses for local
# development is ``postgresql+asyncpg://omnicare:omnicare_password@localhost:15432/omnicare``.

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
# Master switch for the correlation-id middleware, structured JSON log records,
# per-tool latency instrumentation, and GET /api/v1/health/detailed. Turning it
# off removes the hooks themselves rather than only silencing their output, so a
# deployment running its own observability stack pays nothing for ours.
# OBSERVABILITY_ENABLED=true

# Registers the LiteLLM callback that records tokens, dollar cost, and latency
# for every model call. Disable only when an external tracer already collects it.
# LLM_COST_TRACKING_ENABLED=true

# "json" (default) writes one JSON object per line with the request id as a
# field; "text" keeps the single-line layout for reading logs by eye.
# LOG_FORMAT=json

# ------------------------------------------------------------------------------
# LangSmith tracing
# ------------------------------------------------------------------------------
# Traces every agent turn to LangSmith (https://smith.langchain.com): one trace
# per turn with the model calls and tool calls nested under it. Off by default:
# it sends prompts and responses to a third party, so it is opt-in. Reads the
# key from LANGSMITH_API_KEY, created under Settings -> API Keys.
# LANGSMITH_TRACING_ENABLED=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=omnicare-financial

# Optional, for a self-hosted or region-specific deployment; blank uses the
# LangSmith cloud. And, for keys scoped to one workspace of an organization.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# Enabled without a key leaves tracing off and says so at startup rather than
# running untraced; GET /api/v1/health/detailed reports the live configuration.

# ------------------------------------------------------------------------------
# Redis (shared state)
# ------------------------------------------------------------------------------
# Redis is what makes idempotent chat responses and rate-limit counters correct
# when more than one replica serves traffic. Empty (the default) keeps both per
# process.
# REDIS_URL=redis://redis:6379/0

# Where the idempotency cache lives: "memory" (default) or "redis".
# IDEMPOTENCY_STORAGE=memory

# Where rate-limit counters live: "memory" (default) or "redis".
# RATE_LIMIT_STORAGE=memory

# ------------------------------------------------------------------------------
# Session Storage
# ------------------------------------------------------------------------------
# "memory" (default) or "database" (the agent_sessions and agent_session_events
# tables in the application database). Redis never carries sessions.
# SESSION_STORAGE=memory

# Turns replayed into a session that has none of its own, and how many older turns
# are folded into the summary that precedes them.
# SESSION_HISTORY_TURNS=20
# SESSION_HISTORY_COMPACTION_TURNS=60

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Signing key for the session JWTs. A random one is generated per process in
# development; production refuses to start with the shipped placeholder below.
# The stack reads this from the project-root .env; this line documents the value
# the gate tests expect the template to carry.
JWT_SECRET_KEY=your-secret-key-here

# ------------------------------------------------------------------------------
# Ingestion gates
# ------------------------------------------------------------------------------
# OMNICARE_INGEST_PROCEDURES is read straight from the environment by
# app/domain/procedures/ingestion.py rather than from Settings; it defaults to
# true and the run is idempotent.
# OMNICARE_INGEST_PROCEDURES=true
