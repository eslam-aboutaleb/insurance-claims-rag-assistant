# syntax=docker/dockerfile:1
# ==============================================================================
# OmniCare Financial Backend - Development Dockerfile
# ==============================================================================
# Build context: the REPOSITORY ROOT (see docker-compose.dev.yml),
# not ./backend, so libs/ragkit is available. ragkit is installed
# from the local source before the backend package; otherwise uv
# resolves `ragkit>=0.1.0` from PyPI, where an unrelated package
# of the same name exists (its dependency tree conflicts with the
# backend's httpx>=0.28 requirement and breaks resolution).
#
# Differences from production Dockerfile:
#   - Creates a virtual environment at /opt/venv for editable installs.
#   - Uses `uv pip install -e .` for live code reloading during development.
#   - Does NOT remove pip (useful for debugging).
#   - Uvicorn runs with --reload for automatic restart on code changes.
#
# Volume mounts (defined in docker-compose.dev.yml):
#   - ./backend/app:/app/app  - Mount source code for live editing.
# ==============================================================================

FROM python:3.11-slim

# Python runtime optimizations (same as production).
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install system dependencies required for building Python packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install UV package manager (pinned version). Development uses
# uv exclusively for dependency management. The versioned
# installer URL pins both the installer script and the version.
RUN curl -LsSf https://github.com/astral-sh/uv/releases/download/0.12.23/uv-installer.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Set working directory.
WORKDIR /app

# Install the local ragkit library first so the backend's
# `ragkit>=0.1.0` dependency resolves from source, never PyPI.
COPY libs/ragkit /tmp/ragkit
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN uv pip install /tmp/ragkit

# Copy dependency manifest for caching and install the backend in
# editable mode. ragkit is already satisfied by the local install.
COPY backend/pyproject.toml ./
RUN uv pip install -e .

# Copy backend application source code.
COPY backend/app/ ./app/
COPY backend/tests/ ./tests/

# Create a non-root user to run the application
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser \
    && chown -R appuser:appuser /app

USER appuser

# Expose backend API port.
EXPOSE 8000

# Run Uvicorn with --reload for hot-reloading during development.
# --reload watches for file changes and restarts the server automatically.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
